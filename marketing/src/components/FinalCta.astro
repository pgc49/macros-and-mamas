---
import {
  cohortStartDate,
  doorsCloseDate,
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
  waitlistPrice,
} from '../config';
---

<section class="final">
  <div class="wrap">
    <span class="script">Your season. Your ranges. Your coach.</span>
    <h2>Feel like yourself again.</h2>
    {
      isWaitlist ? (
        <div class="open-cta" style="position:relative;z-index:2">
          <p class="lede">
            See your ranges free — then lock ${waitlistPrice} for cohort 2 when
            you're ready.
          </p>
          <a
            class="btn"
            href={quizUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            See your ranges free
          </a>
        </div>
      ) : (
        <div class="open-cta" style="position:relative;z-index:2">
          <a
            class="btn"
            href={enrollUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            Join now · starts {cohortStartDate}
          </a>
          <p class="price-note">
            ${offerPrice} · doors close {doorsCloseDate} or when the cohort fills
          </p>
          <p class="price-note" style="margin-top:10px">
            <a href={quizUrl} style="color:inherit;text-decoration:underline"
              >Or see your ranges free first</a
            >
          </p>
        </div>
      )
    }
  </div>
</section>
