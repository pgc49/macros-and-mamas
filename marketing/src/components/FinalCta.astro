---
import {
  cohortStartDate,
  doorsCloseDate,
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
  waitlistPrice,
  weeklyPrice,
} from '../config';
---

<section class="final">
  <div class="wrap">
    <span class="script">Your season. Your ranges. Your coach.</span>
    <h2>Feel like yourself again.</h2>
    {
      isWaitlist ? (
        <div class="open-cta" style="position:relative;z-index:2">
          <p class="lede">
            Take the free quiz to see your ranges — and unlock the exclusive $
            {waitlistPrice} early rate ($50 off). Pre-pay after the quiz to lock
            your spot for cohort 2 (about ${weeklyPrice}/week for 8 weeks).
          </p>
          <a
            class="btn"
            href={quizUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            Unlock ${waitlistPrice} · see my ranges
          </a>
        </div>
      ) : (
        <div class="open-cta" style="position:relative;z-index:2">
          <a
            class="btn"
            href={enrollUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            Join now · starts {cohortStartDate}
          </a>
          <p class="price-note">
            ${offerPrice} · doors close {doorsCloseDate} or when the cohort fills
          </p>
          <p class="price-note" style="margin-top:10px">
            <a href={quizUrl} style="color:inherit;text-decoration:underline"
              >Or get your macro ranges first</a
            >
          </p>
        </div>
      )
    }
  </div>
</section>
