---
import {
  cohortStartDate,
  cohortStartDateShort,
  enrollUrl,
  fullPrice,
  isWaitlist,
  offerPrice,
  queuePositionCopy,
  quizUrl,
  waitlistPrice,
} from '../config';

---

<section class="final">
  <div class="wrap">
    <span class="script">Your season. Your ranges. Your coach.</span>
    <h2>Feel like yourself again.</h2>
    {
      isWaitlist ? (
        <div class="open-cta" style="position:relative;z-index:2">
          <p class="lede">
            Take the free quiz to see your ranges — and get the exclusive $
            {waitlistPrice} early rate (full rate ${fullPrice}). Lock your spot
            after the quiz in the {cohortStartDateShort} group,
            capped at 50 mamas.
          </p>
          <p class="lede" style="margin-top:14px">
            {queuePositionCopy}
          </p>
          <a
            class="btn"
            href={quizUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            Get my ranges · save $50
          </a>
        </div>
      ) : (
        <div class="open-cta" style="position:relative;z-index:2">
          <a
            class="btn"
            href={enrollUrl}
            style="background:#fff;color:var(--accent-deep)"
          >
            Join now · starts {cohortStartDate}
          </a>
          <p class="price-note">
            ${offerPrice} · when the 50 spots fill · starts {cohortStartDate}
          </p>
          <p class="price-note" style="margin-top:10px">
            <a href={quizUrl} style="color:inherit;text-decoration:underline"
              >Or get your macro ranges first</a
            >
          </p>
        </div>
      )
    }
  </div>
</section>
