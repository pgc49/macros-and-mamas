---
import {
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
} from '../config';
---

<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  {
    isWaitlist ? (
      <>
        <div class="s-price">
          <strong>Ranges built by hand</strong>
        </div>
        <a class="btn" href={quizUrl}>
          Take the quiz
        </a>
      </>
    ) : (
      <>
        <div class="s-price">
          <strong>${offerPrice} · 8 weeks</strong>
          Ranges built by hand
        </div>
        <a class="btn" href={enrollUrl}>
          Join now
        </a>
      </>
    )
  }
</div>
