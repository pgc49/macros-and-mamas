---
import {
  cohortStartDateCompact,
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
} from '../config';

---

<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  {
    isWaitlist ? (
      <>
        <div class="s-price">
          <strong>50 mamas max · starts {cohortStartDateCompact}</strong>
        </div>
        <a class="btn" href={quizUrl}>
          Take the quiz
        </a>
      </>
    ) : (
      <>
        <div class="s-price">
          <strong>When the 50 spots fill</strong>
          Starts {cohortStartDateCompact} · ${offerPrice}
        </div>
        <a class="btn" href={enrollUrl}>
          Join now
        </a>
      </>
    )
  }
</div>
