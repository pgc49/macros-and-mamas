---
import {
  cohortStartDateCompact,
  doorsCloseDate,
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
  waitlistPrice,
  weeklyPrice,
} from '../config';
---

<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  {
    isWaitlist ? (
      <>
        <div class="s-price">
          <strong>Unlock ${waitlistPrice} in the quiz</strong>
          $50 off · about ${weeklyPrice}/week for 8 weeks
        </div>
        <a class="btn" href={quizUrl}>
          Take the quiz
        </a>
      </>
    ) : (
      <>
        <div class="s-price">
          <strong>${offerPrice} for 8 weeks · starts {cohortStartDateCompact}</strong>
          About ${weeklyPrice}/week · doors close {doorsCloseDate}
        </div>
        <a class="btn" href={enrollUrl}>
          Join now
        </a>
      </>
    )
  }
</div>
