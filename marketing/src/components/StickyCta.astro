---
import {
  cohortStartDateCompact,
  doorsCloseDate,
  enrollUrl,
  fullPrice,
  isWaitlist,
  offerPrice,
  quizUrl,
  waitlistPrice,
} from '../config';
---

<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  {
    isWaitlist ? (
      <>
        <div class="s-price">
          <strong>Cohort opening soon</strong>Free ranges · lock $
          {waitlistPrice}
        </div>
        <a class="btn" href={quizUrl}>
          Get your ranges
        </a>
      </>
    ) : (
      <>
        <div class="s-price">
          <strong>${offerPrice} · starts {cohortStartDateCompact}</strong>
          Enrollment open · doors close {doorsCloseDate}
        </div>
        <a class="btn" href={enrollUrl}>
          Join now
        </a>
      </>
    )
  }
</div>
