---
import {
  cohortStartDateCompact,
  doorsCloseDate,
  enrollUrl,
  isWaitlist,
  offerPrice,
  quizUrl,
} from '../config';
---

<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  {
    isWaitlist ? (
      <>
        <div class="s-price">
          <strong>Doors close {doorsCloseDate} · 50 mamas max</strong>
        </div>
        <a class="btn" href={quizUrl}>
          Take the quiz
        </a>
      </>
    ) : (
      <>
        <div class="s-price">
          <strong>Doors close {doorsCloseDate}</strong>
          Starts {cohortStartDateCompact} · ${offerPrice}
        </div>
        <a class="btn" href={enrollUrl}>
          Join now
        </a>
      </>
    )
  }
</div>
