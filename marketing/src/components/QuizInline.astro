---
/**
 * Inline Q1 embed — after sample ranges card.
 * Tapping navigates to /quiz?q1=<value>&placement=inline
 */
import { waitlistPrice } from '../config';

const options = [
  { v: 'still_pregnant', l: 'Still pregnant' },
  { v: '0_3_months', l: '0–3 months' },
  { v: '3_12_months', l: '3–12 months' },
  { v: '1_2_years', l: '1–2 years' },
  { v: '2_plus_years', l: '2+ years' },
  { v: 'not_postpartum', l: 'Not postpartum' },
];
---

<section class="quiz-inline" id="see-ranges">
  <div class="wrap">
    <div class="qi-card">
      <h2>Want to see your macro ranges?</h2>
      <p class="lede"
        >Answer a few questions and get your ranges free, the way Callie
        calculates them. Finishing also unlocks the ${waitlistPrice} early rate.
        Tap where you are to start.</p
      >
      <div class="qi-choices pills grid-2">
        {
          options.map((o) => (
            <a class="q-choice pill link" href={`/quiz?q1=${o.v}&placement=inline`}>
              {o.l}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
