---
/** Slim pull-quote band above pricing — Lauren's "best investment" line. */
import { testimonialById } from "../content/testimonials";

const lauren = testimonialById("lauren");
const pull = lauren?.pull || "";
const who = lauren?.who || "";
---

<section class="quote-echo" aria-label="Mama quote">
  <div class="wrap">
    <p class="qe-pull rv">
      &ldquo;{pull}&rdquo; <span class="qe-who">{who}</span>
    </p>
  </div>
</section>
