---
/** Slim pull-quote band above pricing — Lauren's "best investment" line. */
const pull =
  "If I didn't lose another pound, this would still be the best investment I've made in myself in years.";
const who = "— Lauren, mama of two";
---

<section class="quote-echo" aria-label="Mama quote">
  <div class="wrap">
    <p class="qe-pull rv">
      &ldquo;{pull}&rdquo; <span class="qe-who">{who}</span>
    </p>
  </div>
</section>
