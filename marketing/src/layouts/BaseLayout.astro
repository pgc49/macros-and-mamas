---
import '@fontsource/marcellus/400.css';
import '@fontsource/karla/400.css';
import '@fontsource/karla/500.css';
import '@fontsource/karla/700.css';
import '@fontsource/karla/400-italic.css';
import '@fontsource/karla/700-italic.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import {
  dashboardUrl,
  offerAvailability,
  offerPrice,
  siteUrl,
} from '../config';
import { DEFAULT_META_PIXEL_ID } from '../../functions/_shared/metaPixelId.js';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Sync redirect for standalone PWA / logged-in members (homepage). */
  memberGuard?: boolean;
}

const {
  title,
  description,
  ogTitle = 'Macros and Mamas — Ranges, Not Rules',
  ogDescription = description,
  memberGuard = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteUrl).href;
const noindex =
  import.meta.env.PUBLIC_NOINDEX === 'true' ||
  import.meta.env.PUBLIC_NOINDEX === '1';
const metaPixelId = (
  import.meta.env.PUBLIC_META_PIXEL_ID || DEFAULT_META_PIXEL_ID
).trim();
const metaDomainVerify = (import.meta.env.PUBLIC_META_DOMAIN_VERIFY || '').trim();
const cfWebAnalyticsToken = (
  import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN || ''
).trim();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Macros and Mamas — 8-Week Macro Coaching Program',
  description:
    'An 8-week postpartum-aware macro coaching program with hand-built macro ranges, app-based logging and planning, and direct coaching from certified holistic nutritionist Callie.',
  brand: { '@type': 'Brand', name: 'Macros and Mamas' },
  offers: {
    '@type': 'Offer',
    price: String(offerPrice),
    priceCurrency: 'USD',
    availability: offerAvailability,
    url: siteUrl + '/',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      metaDomainVerify && (
        <meta name="facebook-domain-verification" content={metaDomainVerify} />
      )
    }
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/marcellus-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/karla-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add("js")</script>
    {
      memberGuard && (
        <script is:inline define:vars={{ dashboardUrl }}>
          /* Sync member / PWA guard — must run before paint when possible.
             Same-origin /dashboard so SPA preview overlays keep the session
             on the preview host (not production www). */
          (function () {
            try {
              var standalone =
                (window.matchMedia &&
                  window.matchMedia('(display-mode: standalone)').matches) ||
                navigator.standalone === true;
              var authed = false;
              for (var i = 0; i < localStorage.length; i++) {
                var k = localStorage.key(i) || '';
                if (k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
                  var raw = localStorage.getItem(k);
                  if (raw && raw.indexOf('access_token') !== -1) {
                    authed = true;
                    break;
                  }
                }
              }
              if (standalone || authed) {
                location.replace(dashboardUrl);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    {
      metaPixelId && (
        <script is:inline define:vars={{ metaPixelId }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod
                ? n.callMethod.apply(n, arguments)
                : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(
            window,
            document,
            'script',
            'https://connect.facebook.net/en_US/fbevents.js',
          );
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
        </script>
      )
    }
    {
      cfWebAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfWebAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    {
      metaPixelId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
          />
        </noscript>
      )
    }
    <slot />
    <script is:inline>
      /* Attribution capture → waitlist hidden fields + SPA handoff (sessionStorage).
         anon_id is first-party localStorage — NOT Cloudflare Web Analytics. */
      (function () {
        try {
          var KEY = 'mm_attribution_v1';
          var ANON_KEY = 'mm_anon_id';
          var params = new URLSearchParams(location.search);
          var fbclid = (params.get('fbclid') || '').trim();
          function cookie(n) {
            var m = document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)'));
            return m ? decodeURIComponent(m[1]) : '';
          }
          var anonId = '';
          try {
            anonId = (localStorage.getItem(ANON_KEY) || '').trim();
            if (!anonId) {
              anonId =
                'anon_' +
                (crypto.randomUUID
                  ? crypto.randomUUID()
                  : Date.now() + '_' + Math.random().toString(36).slice(2));
              localStorage.setItem(ANON_KEY, anonId);
            }
          } catch (e) {}
          var refHost = '';
          try {
            if (document.referrer) refHost = new URL(document.referrer).hostname;
          } catch (e) {}
          var data = {
            utm_source: (params.get('utm_source') || '').trim(),
            utm_medium: (params.get('utm_medium') || '').trim(),
            utm_campaign: (params.get('utm_campaign') || '').trim(),
            utm_content: (params.get('utm_content') || '').trim(),
            utm_term: (params.get('utm_term') || '').trim(),
            fbclid: fbclid,
            fbp: cookie('_fbp'),
            fbc: cookie('_fbc') || (fbclid ? 'fb.1.' + Date.now() + '.' + fbclid : ''),
            landing_path: location.pathname || '/',
            referrer_host: refHost,
            anon_id: anonId,
          };
          var prev = {};
          try {
            prev = JSON.parse(sessionStorage.getItem(KEY) || '{}') || {};
          } catch (e) {}
          /* First-touch: keep earlier non-empty values */
          var merged = Object.assign({}, prev);
          Object.keys(data).forEach(function (k) {
            if (!merged[k] && data[k]) merged[k] = data[k];
          });
          sessionStorage.setItem(KEY, JSON.stringify(merged));
          document.querySelectorAll('[data-waitlist-form]').forEach(function (form) {
            [
              'utm_source',
              'utm_medium',
              'utm_campaign',
              'utm_content',
              'utm_term',
              'fbclid',
              'fbp',
              'fbc',
            ].forEach(function (name) {
              var input = form.querySelector('input[name="' + name + '"]');
              if (input && merged[name]) input.value = merged[name];
            });
            var eid = form.querySelector('input[name="event_id"]');
            if (eid && !eid.value) {
              eid.value =
                'lead_' +
                (crypto.randomUUID
                  ? crypto.randomUUID()
                  : Date.now() + '_' + Math.random().toString(36).slice(2));
            }
          });

          /* Append first-touch attribution onto /join and /signin (same-origin
             relative links on www + SPA previews; also absolute www if present). */
          function withAttr(href) {
            try {
              var u = new URL(href, location.href);
              var path = (u.pathname || '').replace(/\/$/, '') || '/';
              if (path !== '/join' && path !== '/signin') return href;
              var host = (u.hostname || '').toLowerCase();
              var here = (location.hostname || '').toLowerCase();
              var isProdApp =
                host === 'www.macrosandmamas.com' || host === 'macrosandmamas.com';
              var isSameOrigin = host === here;
              if (!isProdApp && !isSameOrigin) return href;
              [
                'utm_source',
                'utm_medium',
                'utm_campaign',
                'utm_content',
                'utm_term',
                'fbclid',
              ].forEach(function (k) {
                if (merged[k] && !u.searchParams.get(k)) {
                  u.searchParams.set(k, merged[k]);
                }
              });
              if (merged.anon_id && !u.searchParams.get('mm_anon')) {
                u.searchParams.set('mm_anon', merged.anon_id);
              }
              if (merged.landing_path && !u.searchParams.get('mm_lp')) {
                u.searchParams.set('mm_lp', merged.landing_path);
              }
              // Prefer path+search on same origin so we never bounce previews to www.
              if (isSameOrigin) {
                return u.pathname + u.search + u.hash;
              }
              return u.toString();
            } catch (e) {
              return href;
            }
          }
          document.querySelectorAll('a[href]').forEach(function (a) {
            var next = withAttr(a.getAttribute('href') || '');
            if (next) a.setAttribute('href', next);
          });
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      /* Sticky CTA + scroll reveals */
      (function () {
        var hero = document.querySelector('.hero');
        var pricing = document.getElementById('pricing');
        var bar = document.getElementById('stickyCta');
        if ('IntersectionObserver' in window) {
          if (bar) {
            var pastHero = !hero;
            var pricingInView = false;
            function syncSticky() {
              var show = pastHero && !pricingInView;
              bar.classList.toggle('on', show);
              bar.setAttribute('aria-hidden', String(!show));
            }
            if (hero) {
              new IntersectionObserver(
                function (e) {
                  pastHero = !e[0].isIntersecting && e[0].boundingClientRect.top < 0;
                  syncSticky();
                },
                { threshold: 0 },
              ).observe(hero);
            }
            if (pricing) {
              new IntersectionObserver(
                function (e) {
                  pricingInView = e[0].isIntersecting;
                  syncSticky();
                },
                { threshold: 0, rootMargin: '0px 0px -12% 0px' },
              ).observe(pricing);
            }
          }
          var rvObs = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('in');
                  rvObs.unobserve(en.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -6% 0px' },
          );
          document.querySelectorAll('.rv').forEach(function (el) {
            rvObs.observe(el);
          });
        } else {
          document.querySelectorAll('.rv').forEach(function (el) {
            el.classList.add('in');
          });
          if (bar && !pricing) {
            bar.classList.add('on');
            bar.setAttribute('aria-hidden', 'false');
          }
        }
      })();
    </script>
  </body>
</html>
