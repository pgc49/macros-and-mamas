---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="You're on the list — Macros and Mamas"
  description="You're on the Macros and Mamas waitlist. We'll email you first."
>
  <Header />
  <section class="hero" style="padding-bottom:120px">
    <div class="wrap" style="max-width:640px;text-align:center;margin:0 auto">
      <span class="kicker">You're on the list</span>
      <h1 style="font-size:clamp(36px,6vw,56px);margin:20px 0 18px"
        >Spot saved. We'll take it from here.</h1
      >
      <p class="sub" style="margin:0 auto 28px"
        >You're on the waitlist. No charge today. Waitlist mamas hear first,
        and your locked rate is waiting.</p
      >
      <p class="script" style="margin-bottom:28px">Talk soon — Callie</p>
      <a class="btn" href="/">Back to home</a>
    </div>
  </section>
  <Footer />
</BaseLayout>
