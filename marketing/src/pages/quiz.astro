---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  cohortStartDate,
  doorsCloseDate,
  enrollUrl,
  fullPrice,
  isWaitlist,
  waitlistPrice,
  weeklyPrice,
} from '../config';

const title = 'Get your macro ranges — Macros and Mamas';
const description = `About 90 seconds. Free ranges from Callie, then the exclusive $${waitlistPrice} early rate (full rate $${fullPrice}) for the next cohort.`;

/** Bust CDN/browser cache when quiz-app.js changes (CF was caching ~4h).
 *  Read from cwd/public — Astro prerender rewrites import.meta.url paths. */
const quizJsPath = path.join(process.cwd(), 'public', 'quiz-app.js');
const quizJsV = createHash('sha256')
  .update(readFileSync(quizJsPath))
  .digest('hex')
  .slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="quiz-page">
    <div class="wrap quiz-wrap">
      <noscript>
        <p class="q-copy"
          >Turn on JavaScript to take the ranges quiz, or email
          calista@nourishwithcalista.com and Callie will help you directly.</p
        >
      </noscript>
      <div
        id="quiz-root"
        data-waitlist={isWaitlist ? 'true' : 'false'}
        data-enroll-url={enrollUrl}
        data-offer-price={String(waitlistPrice)}
        data-full-price={String(fullPrice)}
        data-weekly-price={String(weeklyPrice)}
        data-cohort-start={cohortStartDate}
        data-doors-close={doorsCloseDate}
      >
        <p class="q-copy">Loading your quiz…</p>
      </div>
    </div>
  </main>
  <Footer />
  <script is:inline src={`/quiz-app.js?v=${quizJsV}`}></script>
</BaseLayout>
