---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import TwoAm from '../components/TwoAm.astro';
import CallieLetter from '../components/CallieLetter.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Ranges from '../components/Ranges.astro';
import QuizInline from '../components/QuizInline.astro';
import SystemCollage from '../components/SystemCollage.astro';
import Guardrail from '../components/Guardrail.astro';
import WeeksArc from '../components/WeeksArc.astro';
// Hidden until real testimonials are ready — component kept at Quotes.astro
// import Quotes from '../components/Quotes.astro';
import FitCheck from '../components/FitCheck.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { fullPrice, isWaitlist, waitlistPrice, weeklyPrice } from '../config';

const title =
  'Macros and Mamas — Feel like yourself again. 8-week postpartum macro coaching with Callie.';
const description = isWaitlist
  ? `Lose the weight. Keep the muscle. Eat like a mother. Full rate $${fullPrice}. Take the free ranges quiz to unlock the $${waitlistPrice} early rate (about $${weeklyPrice}/week). Hand-built macro ranges, a real app, and Callie in your corner.`
  : 'Lose the weight. Keep the muscle. Eat like a mother. An 8-week coaching program from Callie, certified holistic nutritionist and mom of two boys. Hand-built macro ranges, a real app, and a real human in your corner.';
const ogDescription = isWaitlist
  ? `Full rate $${fullPrice}. Take the free quiz to unlock $${waitlistPrice} for the 8-week postpartum-aware coaching program (about $${weeklyPrice}/week). Hand-built ranges, a real app, and Callie every step of the way.`
  : 'An 8-week postpartum-aware macro coaching program. Hand-built ranges, a real app, and Callie every step of the way.';
---

<BaseLayout
  title={title}
  description={description}
  ogDescription={ogDescription}
  memberGuard
>
  <Header />
  <Hero />
  <Ticker />
  <TwoAm />
  <CallieLetter />
  <StatsStrip />
  <Ranges />
  <QuizInline />
  <SystemCollage />
  <Guardrail />
  <WeeksArc />
  {/* <Quotes /> — re-enable when cohort quotes are approved */}
  <FitCheck />
  <Pricing />
  <Faq />
  <FinalCta />
  <Footer />
  <StickyCta />
</BaseLayout>
