# Cloudflare Pages headers — keep HTML fresh after deploys (avoids Chrome white screens
# from a cached index.html pointing at old hashed JS that no longer matches).

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Real 404 for missing hashed chunks (see public/assets/404.html). Never immutable-cache misses.
/assets/404.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned home-screen icons — long cache is fine; filename changes bust iOS
/apple-touch-icon-v6.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/icon-*-v6.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Marketing quiz client — must pick up offer/CTA deploys immediately
/quiz-app.js
  Cache-Control: no-cache, must-revalidate
