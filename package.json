{
  "name": "macros-and-mamas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "VITE_APP_BUILD_ID=${CF_PAGES_COMMIT_SHA:-${VITE_APP_BUILD_ID:-dev}} vite build && node scripts/maybe-preview-marketing.mjs",
    "build:www-cutover": "MARKETING_WWW_CUTOVER=1 npm run build",
    "lint": "oxlint",
    "qa:credits": "node scripts/qa-credits-math.mjs",
    "qa:channels": "node scripts/qa-channels-notify.mjs",
    "qa:reactions": "node scripts/qa-message-reactions.mjs",
    "qa:messages-thread": "node scripts/smoke-messages-thread.mjs",
    "qa:message-ordering": "node scripts/qa-message-ordering.mjs",
    "test:messaging": "vitest run src/components/messaging-hardening.test.jsx",
    "qa:messaging": "npm run test:messaging && npm run qa:messages-thread && npm run qa:message-ordering && npm run qa:reactions && npm run qa:channels",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
