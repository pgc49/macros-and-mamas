          });
        }
      }
    }
    return json10({ ok: true, checked: prompts.length, posted: posted.length, items: posted }, 200);
  } catch (e) {
    console.error("channel-prompts-cron failed", e);
    return json10({ error: "cron failed" }, 500);
  }
}
