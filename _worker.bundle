        `/rest/v1/credit_ledger?id=eq.${encodeURIComponent(row.id)}&status=eq.pending`,
        {
          method: "PATCH",
          body: JSON.stringify({ status: "available" })
        }
      );
      if (Array.isArray(updated) && updated[0]) stats.vested += 1;
