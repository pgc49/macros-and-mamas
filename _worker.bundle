          await notifySystemMessage(env, msg.id);
        }
        posted.push({ promptId: prompt.id, messageId: msg?.id || null });
      } catch (e) {
        console.error("prompt post failed", prompt.id, e);
        if (claim) {
          await releasePromptClaim(env, prompt.id, claim).catch((err) => {
