    `${base}/rest/v1/profiles?id=eq.${encodeURIComponent(clientId)}`,
    {
      method: "PATCH",
      headers: {
        "content-type": "application/json",
        apikey: key,
        authorization: `Bearer ${key}`,
        prefer: "return=minimal"
      },
      body: JSON.stringify({ status: "active", week: 1 })
    }
  );
  if (!pResp.ok) {
    const detail = await pResp.text();
