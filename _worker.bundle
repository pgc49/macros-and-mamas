  if (!base || !key || !profileId || !emailType) return false;
  try {
    const url = `${base}/rest/v1/email_events?profile_id=eq.${encodeURIComponent(profileId)}&email_type=eq.${encodeURIComponent(emailType)}&select=id&limit=1`;
    const resp = await fetch(url, {
