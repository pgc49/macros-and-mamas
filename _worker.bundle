  if (d === "vegetarian") {
    return "Vegetarian (NO meat, poultry, fish, or shellfish \u2014 eggs & dairy ARE allowed unless listed as allergens)";
  }
  if (d === "vegan") {
    return "Vegan (NO animal products \u2014 meat, fish, eggs, dairy, honey). Hit protein with legumes, tofu/tempeh if soy ok, plant protein powder.";
  }
