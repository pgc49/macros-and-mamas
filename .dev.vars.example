# Copy to .dev.vars for local `npx wrangler pages dev`.
# NEVER commit .dev.vars — it is gitignored.
# Set the same values in Cloudflare Pages → Settings → Environment variables
# (Production + Preview). Use encrypted/secret for every key below.

# OpenRouter (meal photo AI)
OPENROUTER_API_KEY=replace-me

# Stripe Checkout — three one-time prices on the same (or separate) products
STRIPE_SECRET_KEY=replace-me
# Legacy alias still works as founding fallback:
# STRIPE_PRICE_ID=price_...149
STRIPE_PRICE_ID_FOUNDING=price_...149
STRIPE_PRICE_ID_WAITLIST=price_...249
STRIPE_PRICE_ID_FULL=price_...299
STRIPE_WEBHOOK_SECRET=replace-me

# Supabase — URL is public; the server key is webhook-only (never ship to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Service role also invokes Supabase Edge Functions (welcome / approve / refund emails).
# RESEND_API_KEY lives in Supabase secrets — not here.

# Hourly email cron (#1 finish joining, #3 intake reminder) — same value in GitHub Actions
CRON_SECRET=replace-with-long-random-string

# Enrollment gate (mirror src/config.js). While false, only pre-close unpaid accounts can checkout.
# Also used by /api/cohort-waitlist-blast (manual) when opening the next cohort.
ENROLLMENT_OPEN=false
ENROLLMENT_CLOSED_AT=2026-07-26T02:00:00.000Z

# Support form → private GitHub issues (/api/support)
# Fine-grained PAT: this repo only, Issues: Read and write. Nothing else.
GITHUB_TOKEN=replace-me
# Optional override (default pgc49/macros-and-mamas)
# GITHUB_REPO=pgc49/macros-and-mamas
